        {
          "poem_id": "poem_xiaochi",
          "order": 2,
          "text": "小荷才露尖尖角",
          "pinyin": "xiǎo hé cái lù jiān jiān jiǎo"
        },
        {
          "poem_id": "poem_xiaochi",
          "order": 3,
          "text": "早有蜻蜓立上头",
          "pinyin": "zǎo yǒu qīng tíng lì shàng tóu"
        }
      ],
      "annotations": [
        {
          "poem_id": "poem_xiaochi",
          "target": "泉眼",
          "explanation": "泉水流出来的小口。"
        },
        {
          "poem_id": "poem_xiaochi",
          "target": "惜",
          "explanation": "爱惜、舍不得。"
        },
        {
          "poem_id": "poem_xiaochi",
          "target": "尖尖角",
          "explanation": "荷叶刚冒出的尖尖。"
        }
      ],
      "kid_summary": "小泉眼悄悄地流着细细的水，树荫倒映在水面上，软软的、亮亮的。小荷叶刚刚露出尖尖的角，早就有一只蜻蜓站在上面啦。",
      "sort_order": 7
    },
    {
      "id": "poem_jiangxue",
