          "poem_id": "poem_caoyuan",
          "order": 2,
          "text": "野火烧不尽",
          "pinyin": "yě huǒ shāo bú jìn"
        },
        {
          "poem_id": "poem_caoyuan",
          "order": 3,
          "text": "春风吹又生",
          "pinyin": "chūn fēng chuī yòu shēng"
        }
      ],
      "annotations": [
        {
          "poem_id": "poem_caoyuan",
          "target": "离离",
          "explanation": "草长得茂盛的样子。"
        },
        {
          "poem_id": "poem_caoyuan",
          "target": "枯荣",
          "explanation": "枯萎和茂盛。"
        },
        {
          "poem_id": "poem_caoyuan",
          "target": "尽",
          "explanation": "完、没了。"
        }
      ],
      "kid_summary": "古原上的草长得多茂盛呀，每年冬天枯萎，春天又发芽。野火烧也烧不完它，春风一吹，小草又从土里钻出来了。小草的生命力真顽强！",
      "sort_order": 11
    },
